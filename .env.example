# PostgreSQL
# 로컬 Docker: docker compose up -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5431/soom?schema=public"
# 로컬에서는 DATABASE_URL과 동일하게 두면 됩니다.
DIRECT_URL="postgresql://postgres:postgres@localhost:5431/soom?schema=public"

# Neon (프로덕션)
# DATABASE_URL = Neon 대시보드의 "Pooled connection" URL
# DIRECT_URL   = Neon 대시보드의 "Direct connection" URL
# DATABASE_URL="postgresql://...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js (`openssl rand -base64 32`)
AUTH_SECRET=""

# 배포 환경 기준 URL (Vercel 등) — OAuth·사이트맵·OG 메타에 사용
# 프로덕션에서 반드시 설정해야 robots.txt·sitemap.xml이 실제 도메인으로 생성됩니다.
# AUTH_URL="https://your-domain.vercel.app"
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Google Search Console 소유권 확인용 메타 태그 값 (HTML 태그 방식)
# Search Console > 속성 추가 > "HTML 태그"에서 content 값만 입력
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Google OAuth 2.0 (웹 클라이언트)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary (게시글 이미지 업로드) — Cloudinary 대시보드 > Settings > API Keys
# 세 값은 반드시 같은 계정의 값이어야 합니다 (다르면 "cloud_name mismatch" 에러)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
